#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// Key positions per half, used by the thumb mod-taps' positional guard.
#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 51 52 53
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 54 55 56 57 58 59

/ {
    behaviors {
        lsft_capword: lsft_capword {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSFT>, <&caps_word>;
        };
        rsft_capword: rsft_capword {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RSFT>, <&caps_word>;
        };
        tml: thumb_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            hold-trigger-key-positions = <KEYS_R>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };
        tmr: thumb_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            hold-trigger-key-positions = <KEYS_L>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp GRAVE                 &kp N1    &kp N2    &kp N3    &kp N4  &kp N5          &kp N6  &kp N7   &kp N8     &kp N9   &kp N0     &kp EQL
&mt LS(LC(LA(LGUI))) TAB  &kp Q     &kp W     &kp E     &kp R   &kp T           &kp Y   &kp U    &kp I      &kp O    &kp P      &kp MINUS
&lt 1 ESC    &kp A     &kp S     &kp D     &kp F   &kp G           &kp H   &kp J    &kp K      &kp L    &kp SEMI   &lt 1 APOS
&lsft_capword             &kp Z     &kp X     &kp C     &kp V   &kp B           &kp N   &kp M    &kp COMMA  &kp DOT  &kp FSLH   &rsft_capword
&tml LGUI BKSP &tml LALT SPACE &tml LCTL ENTER  &mo 2     &sk LSHFT &kp C_MUTE       &kp C_PP       &sk RSHFT &mo 2      &tmr RCTL ENTER &tmr RALT SPACE &tmr RGUI BKSP
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp UP DOWN>;
        };

        layer_1 {
            display-name = "Nav";
            bindings = <
&trans       &kp F1   &kp F2   &kp F3   &kp F4   &kp F5           &kp F6   &kp F7    &kp F8    &kp F9     &kp F10  &trans
&trans       &kp F6   &kp F7   &kp F8   &kp F9   &kp F10          &kp LC(LG(LEFT)) &kp PGDN  &kp PGUP    &kp LC(LG(RIGHT))    &trans   &trans
&trans       &kp F11  &kp F12  &kp F13  &kp F14  &kp F15          &kp LEFT &kp DOWN  &kp UP    &kp RIGHT  &trans   &trans
&trans       &kp LBKT &kp RBKT &kp LBRC &kp RBRC &kp BSLH         &kp LBKT &kp RBKT  &kp LBRC  &kp RBRC   &kp BSLH &trans
&trans       &trans   &trans   &trans  &trans  &trans             &trans   &trans    &trans    &trans     &trans   &trans
            >;
        };

        layer_2 {
            display-name = "Media";
            bindings = <
&trans  &kp C_BRI_DN  &kp C_BRI_INC  &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS  &trans  &trans      &trans   &kp C_PREV &kp C_PP &kp C_NEXT &kp C_MUTE &kp C_VOL_UP
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR  &bootloader      &trans   &studio_unlock &trans &trans &soft_off &kp C_VOL_DN
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans &trans &trans &trans &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans &trans &trans &trans &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans &trans &trans &trans &trans
            >;
        };
    };
};
